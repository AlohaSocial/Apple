    "Aloha Social is open source under the MIT licence." : {
      "comment" : "Settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloha Social ist Open Source unter der MIT-Lizenz."
