    "Sign in again" : {
      "comment" : "Account state",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut anmelden"
          }
        }
      }
    },
    "Sign out" : {
      "comment" : "Settings action"
    },
    "Sign out?" : {
      "comment" : "Sign-out confirmation"
    },
    "Sign-ins and new accounts are not counted: an account here is a Nextcloud user, so there is no registration for the server to count." : {
      "comment" : "Server info activity explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldungen und neue Konten werden nicht gezählt: Ein Konto hier ist ein Nextcloud-Benutzer, daher gibt es keine Registrierung, die der Server zählen könnte."
          }
        }
      }
    },
    "Signed in %@" : {
      "comment" : "Authorized app sign-in time",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet %@"
          }
        }
      }
    },
    "Signing in didn't finish." : {
      "comment" : "Sign-in authorisation failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung wurde nicht abgeschlossen."
          }
        }
      }
    },
    "Signing in to Social gives this app a Social token, which can't read your files or register for push. Connecting your Nextcloud grants an app password that can — you approve it in your own browser, and this app never sees your password." : {
      "comment" : "Nextcloud connect explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung bei Social gibt dieser App ein Social-Token, das weder deine Dateien lesen noch Push-Benachrichtigungen registrieren kann. Wenn du deine Nextcloud verbindest, erhält die App ein App-Passwort, das das kann – du bestätigst es in deinem eigenen Browser, und diese App sieht dein Passwort nie."
          }
        }
      }
    },
    "Signing out removes everything from this device. Deleting the account itself happens on %@, because that is where it lives." : {
      "comment" : "Account deletion explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abmelden wird alles von diesem Gerät entfernt. Das Konto selbst wird auf %@ gelöscht, denn dort ist es zu Hause."
          }
        }
      }
    },
    "Signing out removes the account from this device. Your posts stay on the server." : {
      "comment" : "Sign-out explanation"
    },
    "Silence" : {
      "comment" : "Moderation action",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stummschalten"
          }
        }
      }
    },
    "Silence this account" : {
      "comment" : "Moderation action",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto stummschalten"
          }
        }
      }
    },
    "Silenced" : {
      "comment" : "Account standing\nModeration standing filter",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stummgeschaltet"
          }
        }
      }
    },
    "Silencing keeps an account's posts from anyone who does not follow it. Suspending stops them being delivered or shown at all. Either way the report is marked handled." : {
      "comment" : "Moderation decisions explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stummschalten verbirgt die Beiträge eines Kontos vor allen, die ihm nicht folgen. Sperren verhindert, dass sie überhaupt zugestellt oder angezeigt werden. In beiden Fällen wird die Meldung als erledigt markiert."
          }
        }
      }
    },
    "Silencing keeps their posts from anyone who does not follow them. Suspending stops them being delivered or shown at all." : {
      "comment" : "Moderation decisions explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
