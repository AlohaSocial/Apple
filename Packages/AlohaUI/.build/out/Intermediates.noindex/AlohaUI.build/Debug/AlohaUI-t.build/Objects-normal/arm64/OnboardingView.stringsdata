  "source": "/Users/karlitschek/Documents/AlohaSocial/AlohaSocial/Packages/AlohaUI/Sources/AlohaUI/Views/OnboardingView.swift",
  "tables": {
    "Localizable": [
      {
        "comment": "Terms gate title",
        "key": "Before you start",
        "location": {
          "startingColumn": 22,
          "startingLine": 35
        }
      },
      {
        "comment": "Terms gate explanation",
        "key": "Aloha Social shows posts from servers across the fediverse. Those servers are run by other people, and this app does not control what they publish.",
        "location": {
          "startingColumn": 21,
          "startingLine": 39
        }
      },
      {
        "comment": "Terms agreement",
        "key": "By continuing you agree to use Aloha Social without posting or promoting objectionable content, and to accept that other people's servers set their own rules.",
        "location": {
          "startingColumn": 21,
          "startingLine": 75
        }
      },
      {
        "comment": "Terms rule",
        "key": "There is zero tolerance for objectionable content and abusive behaviour.",
        "location": {
          "startingColumn": 33,
          "startingLine": 47
        }
      },
      {
        "comment": "Terms rule",
        "key": "You can report any post or account, and block or mute anyone, from anywhere in the app.",
        "location": {
          "startingColumn": 33,
          "startingLine": 53
        }
      },
      {
        "comment": "Terms rule",
        "key": "Reports go to your server's moderators, and optionally to the poster's server too.",
        "location": {
          "startingColumn": 33,
          "startingLine": 59
        }
      },
      {
        "comment": "Terms rule",
        "key": "Accounts that abuse other people are removed from your view as soon as you block them.",
        "location": {
          "startingColumn": 33,
          "startingLine": 65
        }
      },
      {
        "comment": "Terms action",
        "key": "Agree and continue",
        "location": {
          "startingColumn": 30,
          "startingLine": 86
        }
      },
      {
        "comment": "Terms action",
        "key": "Not now",
        "location": {
          "startingColumn": 30,
          "startingLine": 92
        }
      },
      {
        "comment": "Mode selection title",
        "key": "Which feeds do you want?",
        "location": {
          "startingColumn": 18,
          "startingLine": 132
        }
      },
      {
        "comment": "Mode selection explanation",
        "key": "Each one is its own screen, built for what it shows. You can change these later.",
