<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- ALOHA_SHARED_CONTAINER = YES: the standalone file's entitlements plus
         the app group and keychain group every target shares
         (Supporting/README.md). Keep the two files in step. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.social.aloha.app</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)social.aloha.app</string>
    </array>
    <!-- ALOHA_SHAREPLAY = YES (Supporting/README.md): SharePlay, which needs
         the Group Activities capability on the App ID. Otherwise the same as
         the file without -SharePlay; keep them in step. -->
    <key>com.apple.developer.group-session</key>
    <true/>
</dict>
</plist>
