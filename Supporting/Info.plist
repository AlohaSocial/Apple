<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both follow ALOHA_SHARED_CONTAINER (Supporting/Aloha.xcconfig), the
	     same switch that picks this target's entitlements, so the flags
	     cannot claim a group the signature lacks or miss one it has. -->
	<key>AlohaAppGroupEnabled</key>
	<string>$(ALOHA_SHARED_CONTAINER)</string>
	<key>AlohaKeychainSharingEnabled</key>
	<string>$(ALOHA_SHARED_CONTAINER)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>social.aloha.app.refresh</string>
		<string>social.aloha.app.maintenance</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>social.aloha.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alohasocial</string>
			</array>
		</dict>
	</array>
	<!-- Cleartext only on the local network (docs/11 §5): a self-hosted
	     server at http://192.168.x.x[:port] or a .local name. Everything
	     on the internet goes over https; the app upgrades a public http
	     address and the media it loads (`URL.securedForLoading`). -->
	<!-- "Share what's playing" reads the song playing in Apple Music
	     (MusicKit), asked the first time it is used. Song cards look songs up
	     in the catalog too, which needs the MusicKit service on the App ID
	     (Supporting/README.md); without it they stay link cards. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Aloha Social reads the song playing in Apple Music when you choose to share it in a post.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>social.aloha.app.viewingTimeline</string>
		<string>social.aloha.app.viewingStatus</string>
		<string>social.aloha.app.viewingProfile</string>
		<string>social.aloha.app.composing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
</dict>
</plist>
