<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Aloha Social</string>
	<key>CFBundleName</key>
	<string>Aloha Social</string>
	<key>AlohaAppGroupEnabled</key>
	<false/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nextcloud.alohasocial.refresh</string>
		<string>com.nextcloud.alohasocial.maintenance</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.nextcloud.alohasocial</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alohasocial</string>
			</array>
		</dict>
	</array>
	<!-- A self-hosted Nextcloud on a private network is routinely reached
	     over plain http from a bare IP (http://192.168.x.x[:port]). The
	     sign-in screen accepts such addresses by design, and ATS has no
	     wildcard that covers arbitrary addresses, so the exception has to
	     be blanket. The token only travels in cleartext when the server
	     itself was configured that way by its own user; every https URL is
	     unaffected. See docs/11 §5. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Declares up-front that the app uses only OS-provided (exempt)
	     encryption, so App Store review does not stop on export
	     compliance. HTTPS and OAuth are both exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.nextcloud.alohasocial.viewingTimeline</string>
		<string>com.nextcloud.alohasocial.viewingStatus</string>
		<string>com.nextcloud.alohasocial.viewingProfile</string>
		<string>com.nextcloud.alohasocial.composing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
</dict>
</plist>
