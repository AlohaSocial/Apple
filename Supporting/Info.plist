<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registers the OAuth callback scheme. Without this the web
	     authentication session fails its dry run and calls back immediately,
	     which is how the isolation crash was first reached. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nextcloud.alohasocial</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alohasocial</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.nextcloud.alohasocial.viewingTimeline</string>
		<string>com.nextcloud.alohasocial.viewingStatus</string>
		<string>com.nextcloud.alohasocial.viewingProfile</string>
		<string>com.nextcloud.alohasocial.composing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nextcloud.alohasocial.refresh</string>
		<string>com.nextcloud.alohasocial.maintenance</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
