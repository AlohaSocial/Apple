<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both follow ALOHA_SHARED_CONTAINER (Supporting/Aloha.xcconfig), the
	     same switch that picks this target's entitlements, so the flags
	     cannot claim a group the signature lacks or miss one it has. -->
	<key>AlohaAppGroupEnabled</key>
	<string>$(ALOHA_SHARED_CONTAINER)</string>
	<key>AlohaKeychainSharingEnabled</key>
	<string>$(ALOHA_SHARED_CONTAINER)</string>
	<!-- A tapped complication opens the app on alohasocial://watch/… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>social.aloha.app.watch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alohasocial</string>
			</array>
		</dict>
	</array>
	<!-- The watchOS app talks to the same self-hosted servers, including
	     plain-http private-network addresses, so it needs the same ATS
	     exception as the iOS app (see Supporting/Info.plist). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Export compliance: only Apple's own TLS (URLSession, Security.framework)
	     is used, which is exempt. The iOS app says the same through
	     INFOPLIST_KEY_ITSAppUsesNonExemptEncryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
