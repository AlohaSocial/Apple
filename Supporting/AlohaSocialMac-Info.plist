<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app shares its store, keychain group and defaults with its
	     widgets through group.social.aloha.app (AlohaSocialMac.entitlements). -->
	<key>AlohaAppGroupEnabled</key>
	<true/>
	<!-- The app's own links: a tapped widget row, a Control Center control
	     and Spotlight all open the Mac app through alohasocial://. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>social.aloha.app.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alohasocial</string>
			</array>
		</dict>
	</array>
	<!-- The same ATS exception the other targets carry: the sign-in screen
	     accepts plain http from a private network (http://192.168.x.x[:port]),
	     and the Mac client is the place those servers are most likely to be
	     reached from. See Supporting/Info.plist and docs/11 §5. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Handoff: the Mac accepts only the activity types it declares, so
	     without these a post being read on the iPhone could not continue
	     here. The same list as Supporting/Info.plist. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>social.aloha.app.viewingTimeline</string>
		<string>social.aloha.app.viewingStatus</string>
		<string>social.aloha.app.viewingProfile</string>
		<string>social.aloha.app.composing</string>
	</array>
</dict>
</plist>
