<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ALOHA_SHARED_CONTAINER = YES: the standalone file's entitlements plus
         the app group and keychain group every target shares
         (Supporting/README.md). Keep the two files in step. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.social.aloha.app</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)social.aloha.app</string>
    </array>
</dict>
</plist>
