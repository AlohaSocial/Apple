# Transifex client configuration (https://developers.transifex.com/docs/cli).
#
# String Catalogs are multilingual: the source and every translation live in
# the same .xcstrings file, so file_filter and source_file are the same path.
# `tx push -s` uploads new English strings; `tx pull -a` writes translations
# back into the catalogs, which are then committed like any other change.
#
# The resources live in Nextcloud's own Transifex project, where its translation
# community already works; each must be created there before its first push.

[main]
host = https://app.transifex.com
lang_map = pt_BR: pt-BR, pt_PT: pt-PT, zh_CN: zh-Hans, zh_TW: zh-Hant, zh_HK: zh-HK, es_419: es-419, sr@latin: sr-Latn

[o:nextcloud:p:nextcloud:r:aloha-social-alohashareextension]
file_filter = AlohaShareExtension/Localizable.xcstrings
source_file = AlohaShareExtension/Localizable.xcstrings
source_lang = en
type = XCSTRINGS
minimum_perc = 50

